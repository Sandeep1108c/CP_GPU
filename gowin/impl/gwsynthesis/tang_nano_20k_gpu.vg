module tmds_encoder (
  w_clk_pixel,
  n139_7,
  vga_vsync_d,
  vga_hsync_d,
  render_mode,
  w_hsync,
  w_pll_lock,
  w_video_active,
  led_d,
  pal_blue,
  gen_blue,
  vga_rgb_d,
  hsync_pipe,
  por_cnt,
  pal_green,
  gen_green,
  vid_act_pipe,
  gen_red,
  pal_red,
  tmds_blue,
  tmds_green,
  tmds_red
)
;
input w_clk_pixel;
input n139_7;
input vga_vsync_d;
input vga_hsync_d;
input render_mode;
input w_hsync;
input w_pll_lock;
input w_video_active;
input [3:3] led_d;
input [7:0] pal_blue;
input [7:7] gen_blue;
input [2:0] vga_rgb_d;
input [1:1] hsync_pipe;
input [16:16] por_cnt;
input [7:0] pal_green;
input [7:7] gen_green;
input [1:1] vid_act_pipe;
input [6:6] gen_red;
input [7:0] pal_red;
output [9:0] tmds_blue;
output [9:0] tmds_green;
output [9:0] tmds_red;
wire n320_6;
wire VCC;
wire GND;
  tmds_channel u_ch0_blue (
    .w_clk_pixel(w_clk_pixel),
    .n139_7(n139_7),
    .vga_vsync_d(vga_vsync_d),
    .vga_hsync_d(vga_hsync_d),
    .render_mode(render_mode),
    .w_hsync(w_hsync),
    .w_pll_lock(w_pll_lock),
    .led_d(led_d[3]),
    .pal_blue(pal_blue[7:0]),
    .gen_blue(gen_blue[7]),
    .vga_rgb_d(vga_rgb_d[0]),
    .hsync_pipe(hsync_pipe[1]),
    .por_cnt(por_cnt[16]),
    .n320_6(n320_6),
    .tmds_blue(tmds_blue[9:0])
);
  tmds_channel_0 u_ch1_green (
    .w_clk_pixel(w_clk_pixel),
    .n139_7(n139_7),
    .n320_6(n320_6),
    .render_mode(render_mode),
    .w_video_active(w_video_active),
    .led_d(led_d[3]),
    .vga_rgb_d(vga_rgb_d[1]),
    .pal_green(pal_green[7:0]),
    .gen_green(gen_green[7]),
    .vid_act_pipe(vid_act_pipe[1]),
    .tmds_green(tmds_green[9:0])
);
  tmds_channel_1 u_ch2_red (
    .w_clk_pixel(w_clk_pixel),
    .n139_7(n139_7),
    .n320_6(n320_6),
    .render_mode(render_mode),
    .w_video_active(w_video_active),
    .led_d(led_d[3]),
    .vga_rgb_d(vga_rgb_d[2]),
    .gen_red(gen_red[6]),
    .pal_red(pal_red[7:0]),
    .vid_act_pipe(vid_act_pipe[1]),
    .tmds_red(tmds_red[9:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* tmds_encoder */
module hdmi_tx (
  w_clk_pixel,
  w_clk_serial,
  n139_7,
  vga_vsync_d,
  vga_hsync_d,
  render_mode,
  w_hsync,
  w_pll_lock,
  w_video_active,
  led_d,
  pal_blue,
  gen_blue,
  vga_rgb_d,
  hsync_pipe,
  por_cnt,
  pal_green,
  gen_green,
  vid_act_pipe,
  gen_red,
  pal_red,
  tmds_clk_p,
  tmds_clk_n,
  tmds_d_p,
  tmds_d_n
)
;
input w_clk_pixel;
input w_clk_serial;
input n139_7;
input vga_vsync_d;
input vga_hsync_d;
input render_mode;
input w_hsync;
input w_pll_lock;
input w_video_active;
input [3:3] led_d;
input [7:0] pal_blue;
input [7:7] gen_blue;
input [2:0] vga_rgb_d;
input [1:1] hsync_pipe;
input [16:16] por_cnt;
input [7:0] pal_green;
input [7:7] gen_green;
input [1:1] vid_act_pipe;
input [6:6] gen_red;
input [7:0] pal_red;
output tmds_clk_p;
output tmds_clk_n;
output [2:0] tmds_d_p;
output [2:0] tmds_d_n;
wire ser_blue;
wire ser_green;
wire ser_red;
wire ser_clk;
wire [9:0] tmds_blue;
wire [9:0] tmds_green;
wire [9:0] tmds_red;
wire VCC;
wire GND;
  ELVDS_OBUF u_obuf_blue (
    .O(tmds_d_p[0]),
    .OB(tmds_d_n[0]),
    .I(ser_blue) 
);
  ELVDS_OBUF u_obuf_green (
    .O(tmds_d_p[1]),
    .OB(tmds_d_n[1]),
    .I(ser_green) 
);
  ELVDS_OBUF u_obuf_red (
    .O(tmds_d_p[2]),
    .OB(tmds_d_n[2]),
    .I(ser_red) 
);
  ELVDS_OBUF u_obuf_clk (
    .O(tmds_clk_p),
    .OB(tmds_clk_n),
    .I(ser_clk) 
);
  OSER10 u_oser_blue (
    .Q(ser_blue),
    .D0(tmds_blue[0]),
    .D1(tmds_blue[1]),
    .D2(tmds_blue[2]),
    .D3(tmds_blue[3]),
    .D4(tmds_blue[4]),
    .D5(tmds_blue[5]),
    .D6(tmds_blue[6]),
    .D7(tmds_blue[7]),
    .D8(tmds_blue[8]),
    .D9(tmds_blue[9]),
    .PCLK(w_clk_pixel),
    .FCLK(w_clk_serial),
    .RESET(n139_7) 
);
defparam u_oser_blue.GSREN="false";
defparam u_oser_blue.LSREN="true";
  OSER10 u_oser_green (
    .Q(ser_green),
    .D0(tmds_green[0]),
    .D1(tmds_green[1]),
    .D2(tmds_green[2]),
    .D3(tmds_green[3]),
    .D4(tmds_green[4]),
    .D5(tmds_green[5]),
    .D6(tmds_green[6]),
    .D7(tmds_green[7]),
    .D8(tmds_green[8]),
    .D9(tmds_green[9]),
    .PCLK(w_clk_pixel),
    .FCLK(w_clk_serial),
    .RESET(n139_7) 
);
defparam u_oser_green.GSREN="false";
defparam u_oser_green.LSREN="true";
  OSER10 u_oser_red (
    .Q(ser_red),
    .D0(tmds_red[0]),
    .D1(tmds_red[1]),
    .D2(tmds_red[2]),
    .D3(tmds_red[3]),
    .D4(tmds_red[4]),
    .D5(tmds_red[5]),
    .D6(tmds_red[6]),
    .D7(tmds_red[7]),
    .D8(tmds_red[8]),
    .D9(tmds_red[9]),
    .PCLK(w_clk_pixel),
    .FCLK(w_clk_serial),
    .RESET(n139_7) 
);
defparam u_oser_red.GSREN="false";
defparam u_oser_red.LSREN="true";
  OSER10 u_oser_clk (
    .Q(ser_clk),
    .D0(GND),
    .D1(GND),
    .D2(GND),
    .D3(GND),
    .D4(GND),
    .D5(VCC),
    .D6(VCC),
    .D7(VCC),
    .D8(VCC),
    .D9(VCC),
    .PCLK(w_clk_pixel),
    .FCLK(w_clk_serial),
    .RESET(n139_7) 
);
defparam u_oser_clk.GSREN="false";
defparam u_oser_clk.LSREN="true";
  tmds_encoder u_tmds_enc (
    .w_clk_pixel(w_clk_pixel),
    .n139_7(n139_7),
    .vga_vsync_d(vga_vsync_d),
    .vga_hsync_d(vga_hsync_d),
    .render_mode(render_mode),
    .w_hsync(w_hsync),
    .w_pll_lock(w_pll_lock),
    .w_video_active(w_video_active),
    .led_d(led_d[3]),
    .pal_blue(pal_blue[7:0]),
    .gen_blue(gen_blue[7]),
    .vga_rgb_d(vga_rgb_d[2:0]),
    .hsync_pipe(hsync_pipe[1]),
    .por_cnt(por_cnt[16]),
    .pal_green(pal_green[7:0]),
    .gen_green(gen_green[7]),
    .vid_act_pipe(vid_act_pipe[1]),
    .gen_red(gen_red[6]),
    .pal_red(pal_red[7:0]),
    .tmds_blue(tmds_blue[9:0]),
    .tmds_green(tmds_green[9:0]),
    .tmds_red(tmds_red[9:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* hdmi_tx */
