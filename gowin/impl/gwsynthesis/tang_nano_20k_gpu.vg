module tmds_encoder (
  w_clk_pixel,
  n139_5,
  vga_vsync_d,
  vga_hsync_d,
  render_mode,
  w_hsync,
  w_video_active,
  led_d,
  gen_blue,
  pal_blue,
  hsync_pipe,
  vid_act_pipe,
  gen_green,
  pal_green,
  vga_rgb_d,
  gen_red,
  pal_red,
  tmds_blue,
  tmds_green,
  tmds_red
)
;
input w_clk_pixel;
input n139_5;
input vga_vsync_d;
input vga_hsync_d;
input render_mode;
input w_hsync;
input w_video_active;
input [3:3] led_d;
input [7:7] gen_blue;
input [7:0] pal_blue;
input [1:1] hsync_pipe;
input [1:1] vid_act_pipe;
input [7:7] gen_green;
input [7:0] pal_green;
input [2:2] vga_rgb_d;
input [6:6] gen_red;
input [7:0] pal_red;
output [9:0] tmds_blue;
output [9:0] tmds_green;
output [9:0] tmds_red;
wire n320_6;
wire VCC;
wire GND;
  tmds_channel u_ch0_blue (
    .w_clk_pixel(w_clk_pixel),
    .n139_5(n139_5),
    .vga_vsync_d(vga_vsync_d),
    .vga_hsync_d(vga_hsync_d),
    .render_mode(render_mode),
    .w_hsync(w_hsync),
    .w_video_active(w_video_active),
    .led_d(led_d[3]),
    .gen_blue(gen_blue[7]),
    .pal_blue(pal_blue[7:0]),
    .hsync_pipe(hsync_pipe[1]),
    .vid_act_pipe(vid_act_pipe[1]),
    .n320_6(n320_6),
    .tmds_blue(tmds_blue[9:0])
);
  tmds_channel_0 u_ch1_green (
