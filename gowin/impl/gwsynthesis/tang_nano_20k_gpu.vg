    .OB(tmds_d_n[2]),
    .I(ser_red) 
);
  ELVDS_OBUF u_obuf_clk (
    .O(tmds_clk_p),
    .OB(tmds_clk_n),
    .I(ser_clk) 
);
  OSER10 u_oser_blue (
    .Q(ser_blue),
    .D0(tmds_blue[0]),
    .D1(tmds_blue[1]),
    .D2(tmds_blue[2]),
    .D3(tmds_blue[3]),
    .D4(tmds_blue[4]),
    .D5(tmds_blue[5]),
    .D6(tmds_blue[6]),
    .D7(tmds_blue[7]),
