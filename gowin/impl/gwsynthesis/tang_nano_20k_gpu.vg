    .FCLK(w_clk_serial),
    .RESET(n139_5) 
);
defparam u_oser_blue.GSREN="false";
defparam u_oser_blue.LSREN="true";
  OSER10 u_oser_green (
    .Q(ser_green),
    .D0(tmds_green[0]),
    .D1(tmds_green[1]),
    .D2(tmds_green[2]),
    .D3(tmds_green[3]),
    .D4(tmds_green[4]),
    .D5(tmds_green[5]),
    .D6(tmds_green[6]),
    .D7(tmds_green[7]),
    .D8(tmds_green[8]),
    .D9(tmds_green[9]),
    .PCLK(w_clk_pixel),
    .FCLK(w_clk_serial),
    .RESET(n139_5) 
);
defparam u_oser_green.GSREN="false";
defparam u_oser_green.LSREN="true";
  OSER10 u_oser_red (
    .Q(ser_red),
    .D0(tmds_red[0]),
    .D1(tmds_red[1]),
    .D2(tmds_red[2]),
    .D3(tmds_red[3]),
    .D4(tmds_red[4]),
    .D5(tmds_red[5]),
    .D6(tmds_red[6]),
    .D7(tmds_red[7]),
    .D8(tmds_red[8]),
    .D9(tmds_red[9]),
    .PCLK(w_clk_pixel),
    .FCLK(w_clk_serial),
    .RESET(n139_5) 
);
defparam u_oser_red.GSREN="false";
defparam u_oser_red.LSREN="true";
  OSER10 u_oser_clk (
    .Q(ser_clk),
    .D0(GND),
    .D1(GND),
    .D2(GND),
    .D3(GND),
    .D4(GND),
    .D5(VCC),
    .D6(VCC),
    .D7(VCC),
    .D8(VCC),
    .D9(VCC),
    .PCLK(w_clk_pixel),
    .FCLK(w_clk_serial),
    .RESET(n139_5) 
);
defparam u_oser_clk.GSREN="false";
defparam u_oser_clk.LSREN="true";
  tmds_encoder u_tmds_enc (
    .w_clk_pixel(w_clk_pixel),
    .n139_5(n139_5),
    .vga_vsync_d(vga_vsync_d),
    .vga_hsync_d(vga_hsync_d),
    .render_mode(render_mode),
    .w_hsync(w_hsync),
    .w_video_active(w_video_active),
    .led_d(led_d[3]),
    .gen_blue(gen_blue[7]),
    .pal_blue(pal_blue[7:0]),
    .hsync_pipe(hsync_pipe[1]),
    .vid_act_pipe(vid_act_pipe[1]),
    .gen_green(gen_green[7]),
    .pal_green(pal_green[7:0]),
    .vga_rgb_d(vga_rgb_d[2]),
    .gen_red(gen_red[6]),
    .pal_red(pal_red[7:0]),
    .tmds_blue(tmds_blue[9:0]),
    .tmds_green(tmds_green[9:0]),
    .tmds_red(tmds_red[9:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
